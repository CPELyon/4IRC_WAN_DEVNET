{# Exemple fourni : configuration d'un routeur du cœur à partir de data/cores.yaml.
    Données attendues : device (un élément de devices) et ospf (bloc ospf du fichier). #}
hostname {{ device.hostname }}
!
interface Loopback0
 description Router-ID
 ip address {{ device.loopback | ip_addr }} {{ device.loopback | netmask }}
!
interface {{ device.noc.interface }}
 description NOC (administration)
 ip address {{ device.noc.ip | ip_addr }} {{ device.noc.ip | netmask }}
 vrrp {{ device.noc.vrrp.group }} ip {{ device.noc.vrrp.vip }}
 vrrp {{ device.noc.vrrp.group }} priority {{ device.noc.vrrp.priority }}
{% if device.noc.vrrp.preempt %}
 vrrp {{ device.noc.vrrp.group }} preempt
{% endif %}
 no shutdown
!
{% for link in device.links %}
interface {{ link.interface }}
 description {{ link.peer }}
 ip address {{ link.ip | ip_addr }} {{ link.ip | netmask }}
 no shutdown
!
{% endfor %}
router ospf {{ ospf.process_id }}
 router-id {{ device.loopback | ip_addr }}
 passive-interface {{ device.noc.interface }}
 passive-interface Loopback0
 network 10.0.0.0 0.0.0.255 area {{ ospf.area }}
 network 10.255.0.0 0.0.0.255 area {{ ospf.area }}
!
{% for route in device.admin_routes %}
ip route {{ route.prefix | ip_addr }} {{ route.prefix | netmask }} {{ route.next_hop }}
{% endfor %}
